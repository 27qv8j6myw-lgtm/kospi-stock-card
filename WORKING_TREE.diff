+ * - 가중: 1차 익절%×분할매도비율 + 최종%×잔여
+ * - 기대(확률): 1차%×(1M 달성확률/100) + 최종%×(3M 달성확률/100)
+ */
+export function computeStrategyRiskRewardMetrics(params: {
+  stopLossPct: number
+  firstTakeProfitPct: number
+  firstTakeProfitSellPct: number
+  finalTargetPct: number
+  prob1M: number
+  prob3M: number
