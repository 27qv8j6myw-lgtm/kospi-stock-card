{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/[[...path]].mjs": {
      "maxDuration": 300
    },
    "api/admin-sync-stocks-fetch.mjs": {
      "maxDuration": 60
    },
    "api/admin-sync-stocks-batch.mjs": {
      "maxDuration": 30
    },
    "api/refresh-stock-market-batch.mjs": {
      "maxDuration": 300
    },
    "api/cron-snapshot.mjs": {
      "maxDuration": 300
    },
    "api/cron-daily-brief.mjs": {
      "maxDuration": 300
    },
    "api/mcp.mjs": {
      "maxDuration": 60
    },
    "api/oauth/*.mjs": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron-snapshot",
      "schedule": "40 6 * * 1-5"
    },
    {
      "path": "/api/cron-daily-brief",
      "schedule": "50 6 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth/metadata?doc=as"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api/mcp",
      "destination": "/api/oauth/metadata?doc=as"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth/metadata?doc=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth/metadata?doc=prm"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
