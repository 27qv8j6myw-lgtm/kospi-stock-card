{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/[[...path]].mjs": {
      "maxDuration": 300
    },
    "api/admin-sync-stocks-fetch.mjs": {
      "maxDuration": 60
    },
    "api/admin-sync-stocks-batch.mjs": {
      "maxDuration": 30
    },
    "api/refresh-stock-market-batch.mjs": {
      "maxDuration": 300
    },
    "api/cron-snapshot.mjs": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-snapshot",
      "schedule": "40 6 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
